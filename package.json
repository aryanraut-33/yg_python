{
  "name": "yg-python",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "pyodide:copy": "node scripts/copy-pyodide.mjs",
    "predev": "npm run pyodide:copy",
    "dev": "vite",
    "prebuild": "npm run pyodide:copy",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler pages deploy dist --project-name yg-python",
    "test:checks": "python3 scripts/test-checks.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "pyodide": "^314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
